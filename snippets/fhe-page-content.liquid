          <button type="button" class="fhe-filter-btn" data-filter="high protein">💪 High Protein</button>
          <button type="button" class="fhe-filter-btn" data-filter="vegetarian">🌱 Vegetarian</button>
          <button type="button" class="fhe-filter-btn" data-filter="vegan">🌿 Vegan</button>
