{% comment %}
  KwikMeal Fresh Heat-N-Eat — Full Page Content Snippet
  Renders the complete FHE landing experience via {% render %} from page.liquid.
  This bypasses the Shopify template-assignment limitation for unpublished themes.
  Contains: Hero, How It Works, Cutoff Banner, Menu (12 dummy meals), Testimonials, FAQ, Delivery Checker, CTA.
{% endcomment %}

<div class="fhe-landing-wrapper">

  <!-- ========== HERO SECTION ========== -->
  <div class="fhe-hero-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-hero-card">
        <div class="fhe-hero-grid">
          <div class="fhe-hero-content">
            <div class="fhe-badge-pill fhe-badge-pill--accent">
              <span>🌱</span> Fresh Chef-Prepared Meals
            </div>
            <h1 class="fhe-hero-title">Fresh Chef Prepared Meals Delivered Weekly</h1>
            <p class="fhe-hero-subtitle">Freshly cooked. Delivered cold. Ready in minutes. Order before Sunday's cutoff.</p>
            <div class="fhe-hero-delivery-badge">
              <span>📦</span>
              <span>Next Delivery: <strong class="fhe-calculated-delivery-date">Friday Delivery</strong></span>
            </div>
            <div class="fhe-zip-box fhe-hero-zip-box">
              <label class="fhe-hero-zip-label">Check Delivery Availability in Your Area:</label>
              <form class="fhe-zip-form">
                <input type="text" class="fhe-zip-input" placeholder="Enter ZIP Code (e.g. 48187)" required>
                <button type="submit" class="fhe-btn fhe-btn--primary">Check ZIP</button>
              </form>
              <div class="fhe-zip-status"></div>
            </div>
            <div class="fhe-hero-actions">
              <a href="#fhe-menu-section" class="fhe-btn fhe-btn--accent">Browse Available Meals ↓</a>
            </div>
            <div class="fhe-hero-trust-strip">
              <div class="fhe-hero-trust-item"><span>👨‍🍳</span> Chef Prepared</div>
              <div class="fhe-hero-trust-item"><span>❄️</span> Chilled Fresh (Never Frozen)</div>
              <div class="fhe-hero-trust-item"><span>⏱️</span> Ready in 3 Minutes</div>
            </div>
          </div>
          <div class="fhe-hero-media">
            <img
              src="{{ 'fhe_banner_meal.png' | asset_url }}"
              alt="Fresh Chef Prepared Heat-N-Eat Meals"
              loading="eager"
              width="900"
              height="600"
              class="fhe-hero-img"
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== HOW IT WORKS ========== -->
  <div class="fhe-how-it-works-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-section-header">
        <div class="fhe-badge-pill">Simple & Convenient</div>
        <h2 class="fhe-title-section">How Weekly Pre-Ordering Works</h2>
        <p class="fhe-subtitle">Fresh meals crafted by chefs, delivered straight to your door every week.</p>
      </div>
      <div class="fhe-steps-grid">
        <div class="fhe-step-card">
          <div class="fhe-step-num">🔍</div>
          <h3 class="fhe-step-title">Browse Meals</h3>
          <p class="fhe-step-desc">Explore our chef-curated weekly menu of authentic, delicious Heat-N-Eat meals.</p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">🍱</div>
          <h3 class="fhe-step-title">Choose Meals</h3>
          <p class="fhe-step-desc">Select single meals, weekly combos, and add-ons like extra rice, naan, and desserts.</p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">⏰</div>
          <h3 class="fhe-step-title">Order Before Cutoff</h3>
          <p class="fhe-step-desc">Place your order before Sunday 11:00 AM for current week delivery batch.</p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">🚚</div>
          <h3 class="fhe-step-title">Receive Fresh Meals</h3>
          <p class="fhe-step-desc">Enjoy chilled, chef-prepared meals delivered every Friday ready in 3 minutes!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== CUTOFF BANNER ========== -->
  <div class="fhe-section" style="padding: 30px 0;">
    <div class="fhe-container">
      <div class="fhe-cutoff-bar">
        <div class="fhe-cutoff-bar__info">
          <div class="fhe-cutoff-bar__icon">🚚</div>
          <div>
            <div class="fhe-cutoff-bar__text">
              Current Production Batch: Delivery on <span class="fhe-calculated-delivery-date fhe-cutoff-bar__date">Friday Delivery</span>
            </div>
            <div style="font-size: 13px; opacity: 0.85; margin-top: 2px;">
              Orders placed after Sunday 11:00 AM automatically move to the following week's delivery.
            </div>
          </div>
        </div>
        <div class="fhe-cutoff-timer">
          <span>⏳</span>
          <span class="fhe-calculated-cutoff-timer">Calculating cutoff deadline...</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== MEAL MENU (12 DUMMY MEALS) ========== -->
