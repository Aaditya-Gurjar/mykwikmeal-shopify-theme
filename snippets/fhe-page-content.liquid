{% comment %}
  KwikMeal Fresh Heat-N-Eat  Full Page Content Snippet
  Renders the complete FHE landing experience via {% render %} from page.liquid.
  This bypasses the Shopify template-assignment limitation for unpublished themes.
  Contains: Hero, How It Works, Cutoff Banner, live menu, Testimonials, FAQ, Delivery Checker, CTA.
{% endcomment %}

<div class="fhe-landing-wrapper">

  <!-- ========== HERO SECTION ========== -->
  <div class="fhe-hero-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-hero-card">
        <div class="fhe-hero-grid">
          <div class="fhe-hero-content">
            <div class="fhe-badge-pill fhe-badge-pill--accent">
              <span aria-hidden="true">&#127807;</span> Fresh Chef Prepared Meals
            </div>
            <h1 class="fhe-hero-title">Fresh Chef Prepared Meals Delivered Weekly</h1>
            <p class="fhe-hero-subtitle">Freshly cooked. Delivered cold. Ready in minutes. Order before Sunday Midnight.</p>
            <div class="fhe-hero-delivery-badge">
              <span aria-hidden="true">&#128230;</span>
              <span>Next Delivery: <strong class="fhe-calculated-delivery-date">Friday Delivery</strong></span>
            </div>
            <div class="fhe-zip-box fhe-hero-zip-box">
              <label class="fhe-hero-zip-label">Check Delivery Availability in Your Area:</label>
              <form class="fhe-zip-form">
                <input type="text" class="fhe-zip-input" placeholder="Enter ZIP Code (e.g. 48187)" required>
                <button type="submit" class="fhe-btn fhe-btn--primary">Check ZIP</button>
              </form>
              <div class="fhe-zip-status"></div>
            </div>
            <div class="fhe-hero-actions">
              <a href="#fhe-menu-section" class="fhe-btn fhe-btn--accent">Browse Available Meals &darr;</a>
            </div>
            <div class="fhe-hero-trust-strip">
              <div class="fhe-hero-trust-item"><span aria-hidden="true">&#128104;&#8205;&#127859;</span> Chef Prepared</div>
              <div class="fhe-hero-trust-item"><span aria-hidden="true">&#128230;</span> Delivered Fresh (Never Frozen)</div>
              <div class="fhe-hero-trust-item"><span aria-hidden="true">&#9201;</span> Ready in 2 Minutes</div>
            </div>
          </div>
          <div class="fhe-hero-media">
            <img
              src="{{ 'fhe_banner_meal.png' | asset_url }}"
              alt="Fresh Chef Prepared Heat-N-Eat Meals"
              loading="eager"
              width="900"
              height="600"
              class="fhe-hero-img"
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== HOW IT WORKS ========== -->
  <div class="fhe-how-it-works-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-section-header">
        <div class="fhe-badge-pill">Simple & Convenient</div>
        <h2 class="fhe-title-section">How Weekly Pre-Ordering Works</h2>
        <p class="fhe-subtitle">Fresh meals crafted by chefs, delivered straight to your door every week.</p>
      </div>
      <div class="fhe-steps-grid">
        <div class="fhe-step-card">
          <div class="fhe-step-num">1</div>
          <h3 class="fhe-step-title">Browse Meals</h3>
          <p class="fhe-step-desc">Explore our chef-curated menu of authentic, delicious Heat-N-Eat meals.</p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">2</div>
          <h3 class="fhe-step-title">Select Single Meal</h3>
          <p class="fhe-step-desc">Select a single meal and customize with optional add-ons like Raita, Salad, and Roti.</p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">3</div>
          <h3 class="fhe-step-title">Order Before Cutoff</h3>
          <p class="fhe-step-desc"><span class="fhe-calculated-cutoff-deadline">Order before Sunday (11:59 PM) for Friday Delivery</span></p>
        </div>
        <div class="fhe-step-card">
          <div class="fhe-step-num">4</div>
          <h3 class="fhe-step-title">Receive Fresh Meals</h3>
          <p class="fhe-step-desc">Enjoy chef-prepared meals delivered every Friday. Ready in 2 minutes!</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== CUTOFF BANNER ========== -->
  <div class="fhe-section" style="padding: 30px 0;">
    <div class="fhe-container">
      <div class="fhe-cutoff-bar">
        <div class="fhe-cutoff-bar__info">
          <div class="fhe-cutoff-bar__icon" aria-hidden="true">&#128666;</div>
          <div>
            <div class="fhe-cutoff-bar__text">
              Next Delivery Date: <span class="fhe-calculated-delivery-date fhe-cutoff-bar__date">Friday Delivery</span>
            </div>
            <div style="font-size: 13px; opacity: 0.85; margin-top: 2px;">
              Orders placed after Sunday Midnight automatically move to the following week's delivery.
            </div>
          </div>
        </div>
        <div class="fhe-cutoff-timer">
          <span aria-hidden="true">&#9203;</span>
          <span class="fhe-calculated-cutoff-timer">Calculating cutoff deadline...</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== DELIVERY CHARGE BANNER ========== -->
  <div class="fhe-delivery-charge-banner">
    <div class="container-fluid">
      <div class="fhe-delivery-charge-card fhe-delivery-charge-card--reverse">
        <span class="fhe-delivery-icon" aria-hidden="true">&#128230;</span>
        <span class="fhe-delivery-text">Flat Handling &amp; Delivery Charges: <strong class="fhe-delivery-badge">$10.00</strong> per order</span>
      </div>
    </div>
  </div>

  <!-- ========== MEAL MENU ========== -->
  <div id="fhe-menu-section" class="fhe-menu-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-section-header">
        <div class="fhe-badge-pill">This Week's Menu</div>
        <h2 class="fhe-title-section">Chef Prepared Heat-N-Eat Meals</h2>
        <p class="fhe-subtitle">Delivered fresh, ready to heat and serve in 2 minutes.</p>
      </div>

      <!-- Filter, Search & Sort Toolbar -->
      <div class="fhe-filter-bar">
        <div class="fhe-filter-pills">
          <button type="button" class="fhe-filter-btn is-active" data-filter="all">All Meals</button>
          <button type="button" class="fhe-filter-btn" data-filter="high protein">&#128170; High Protein</button>
          <button type="button" class="fhe-filter-btn" data-filter="vegetarian">&#127793; Vegetarian</button>
          <button type="button" class="fhe-filter-btn" data-filter="vegan">&#127807; Vegan</button>
          <button type="button" class="fhe-filter-btn" data-filter="gluten free">&#127806; Gluten Free</button>
        </div>
        <div class="fhe-menu-controls">
          <div class="fhe-menu-search-wrap">
            <input type="text" class="fhe-menu-search-input" placeholder="Search meals..." aria-label="Search meals">
          </div>
          <select class="fhe-menu-sort-select" aria-label="Sort meals">
            <option value="default">Sort: Featured</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="calories">Calories: Low to High</option>
          </select>
        </div>
      </div>

      <!-- Meal Cards Grid -->
      <div class="fhe-menu-grid">
        {% assign fhe_collection = collections['fresh-heat-n-eat'] %}
        {% if fhe_collection != blank and fhe_collection.products.size > 0 %}
          {% for product in fhe_collection.products limit: 50 %}
            {% render 'fresh-meal-card', product: product %}
          {% endfor %}
        {% else %}
          {% assign tagged_meal_count = 0 %}
          {% for product in collections.all.products limit: 250 %}
            {% if product.tags contains 'fresh-heat-n-eat' or product.type contains 'Heat-N-Eat' %}
              {% render 'fresh-meal-card', product: product %}
              {% assign tagged_meal_count = tagged_meal_count | plus: 1 %}
            {% endif %}
          {% endfor %}

          {% if tagged_meal_count == 0 %}
            <div class="fhe-menu-empty" role="status">
              <h3>This week's menu is coming soon.</h3>
              <p>No active Fresh Heat-N-Eat products are available yet.</p>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <!-- ========== TESTIMONIALS ========== -->
  <div class="fhe-testimonials-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-section-header">
        <div class="fhe-badge-pill">Real Reviews</div>
        <h2 class="fhe-title-section">Loved by Busy Food Lovers</h2>
        <p class="fhe-subtitle">Over 1,000+ weekly pre-orders delivered across Michigan.</p>
      </div>
      <div class="fhe-testimonials-grid">
        <div class="fhe-testimonial-card">
          <div class="fhe-testimonial-card__rating" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="fhe-testimonial-card__quote">"The Butter Chicken heat-and-eat meal is restaurant-quality! Delivered cold on Friday, heated in 2 minutes after work. Game changer!"</p>
          <div class="fhe-testimonial-card__author">
            <div class="fhe-testimonial-card__avatar">S</div>
            <div>
              <strong class="fhe-testimonial-card__name">Sarah M.</strong>
              <span class="fhe-testimonial-card__location">Canton, MI</span>
            </div>
          </div>
        </div>
        <div class="fhe-testimonial-card">
          <div class="fhe-testimonial-card__rating" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="fhe-testimonial-card__quote">"No subscriptions, no hidden fees, just ordering delicious weekly Indian meals before Sunday's cutoff. Highly recommended!"</p>
          <div class="fhe-testimonial-card__author">
            <div class="fhe-testimonial-card__avatar">R</div>
            <div>
              <strong class="fhe-testimonial-card__name">Rahul P.</strong>
              <span class="fhe-testimonial-card__location">Novi, MI</span>
            </div>
          </div>
        </div>
        <div class="fhe-testimonial-card">
          <div class="fhe-testimonial-card__rating" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="fhe-testimonial-card__quote">"Love the macro breakdown and high protein meals. Packaging keeps everything cold and fresh until Friday delivery."</p>
          <div class="fhe-testimonial-card__author">
            <div class="fhe-testimonial-card__avatar">A</div>
            <div>
              <strong class="fhe-testimonial-card__name">Amanda K.</strong>
              <span class="fhe-testimonial-card__location">Plymouth, MI</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== FAQ ========== -->
  <div class="fhe-faq-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-section-header">
        <div class="fhe-badge-pill">Got Questions?</div>
        <h2 class="fhe-title-section">Frequently Asked Questions</h2>
        <p class="fhe-subtitle">Everything you need to know about KwikMeal Fresh Heat-N-Eat.</p>
      </div>
      <div class="fhe-faq-list">
        <div class="fhe-faq-item is-open">
          <button type="button" class="fhe-faq-question" aria-expanded="true">
            <span>How does weekly pre-ordering work?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            We operate on a weekly production cycle. Place your order before Sunday Midnight (11:59 PM), and our chefs prepare your fresh meals for delivery on Friday. Orders placed after Sunday Midnight automatically move to the following week's delivery.
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>Can I cancel my order and get a refund?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            Since, all meals are made to order, once the ordering cutoff (Sunday Midnight) has passed, cancellation and refund will not be possible. However, if you cancel your order before the cutoff day and time, we will refund your payment in full to your original mode of payment.
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>Is this a subscription service?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            No. There are no mandatory subscriptions or recurring commitments. Order as many or as few meals as you like, whenever you like.
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>How are meals packaged and delivered?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            Meals are delivered fresh and chilled (never frozen) in tamper-proof sealed trays. These trays are packed in a corrugated box. Since, meals are delivered at refrigerated temperature, someone must be available at your doorstep to receive the delivery. Meals will not be left on the porch due to food safety reasons. We will send you an SMS with an approximate 1-hour delivery window.
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>Is there a delivery charge?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            Yes, there is a flat $10 handling and delivery charge per order, regardless of the quantity of meals ordered. This charge will appear at the payment checkout.
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>How do I reheat my meals?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            <p><strong>Microwave:</strong> Peel back film of both compartments or single compartment tray about an inch. Microwave on HIGH for 2&ndash;3 minutes. Tray and contents will be hot. Carefully remove tray. Let stand for 1 minute before serving.</p>
            <p style="margin-top: 8px;"><strong>Oven:</strong> You can also heat it in a preheated oven. Cover tray with aluminum foil. Internal food temperature must reach 165&deg;F (74&deg;C).</p>
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>Which ZIP codes do you deliver to?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            We currently deliver to select ZIP codes in Michigan including Canton (48187, 48188), Plymouth (48170), Livonia (48150&ndash;48154), Farmington Hills (48025, 48331, 48334&ndash;48336), Novi (48374&ndash;48377, 48167), Northville (48167, 48168), and Westland (48185, 48186). Check your ZIP code in our availability checker above!
          </div>
        </div>
        <div class="fhe-faq-item">
          <button type="button" class="fhe-faq-question" aria-expanded="false">
            <span>Can I order other grocery items along with my meals?</span>
            <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
          </button>
          <div class="fhe-faq-answer">
            Absolutely! In addition to your Heat-N-Eat meals, you can also order other grocery items from our website. They will be delivered together with your meal order on Friday.
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== DELIVERY CHECKER ========== -->
  <div class="fhe-section" style="padding: 70px 0; background: var(--fhe-light-bg);">
    <div class="fhe-container">
      <div style="max-width: 800px; margin: 0 auto; background: #ffffff; border: 1px solid var(--fhe-border); border-radius: var(--fhe-radius-lg); padding: 48px 36px; box-shadow: var(--fhe-shadow-md); text-align: center;">
        <div class="fhe-badge-pill" style="margin-bottom: 12px;">Delivery Area</div>
        <h2 class="fhe-title-section" style="margin-bottom: 12px;">Check Delivery Availability</h2>
        <p class="fhe-subtitle" style="margin: 0 auto 28px;">Fresh Heat-N-Eat is currently available in select Michigan communities.</p>
        <form class="fhe-zip-form" style="max-width: 440px; margin: 0 auto;">
          <input type="text" class="fhe-zip-input" placeholder="Enter ZIP Code (e.g. 48187)" required>
          <button type="submit" class="fhe-btn fhe-btn--primary" style="padding: 12px 28px;">Check ZIP</button>
        </form>
        <div class="fhe-zip-status" style="max-width: 440px; margin: 16px auto 0;"></div>
        <div style="margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--fhe-border);">
          <h4 style="font-size: 15px; font-weight: 700; color: var(--fhe-dark); margin-bottom: 12px;">Supported Delivery Cities:</h4>
          <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 10px;">
            <span class="fhe-badge-pill fhe-badge-pill--dark">Canton (48187, 48188)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Plymouth (48170)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Livonia (48150 - 48154)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Farmington Hills (48025, 48331, 48334 - 48336)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Novi (48374 - 48377, 48167)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Northville (48167, 48168)</span>
            <span class="fhe-badge-pill fhe-badge-pill--dark">Westland (48185, 48186)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== BOTTOM CTA ========== -->
  <div class="fhe-cta-section m-section-my">
    <div class="container-fluid">
      <div class="fhe-cta-card">
        <div class="fhe-cta-card__glow"></div>
        <div class="fhe-cta-content">
          <div class="fhe-badge-pill fhe-badge-pill--accent">
            <span aria-hidden="true">&#9200;</span> Weekly Pre-Order System
          </div>
          <h2 class="fhe-cta-title">Ready to Eat Fresh Chef Prepared Meals This Friday?</h2>
          <p class="fhe-cta-subtitle">Order before Sunday's cutoff. Delivered fresh & chilled to your door.</p>
          <div class="fhe-cta-cutoff-pill">
            <span aria-hidden="true">&#128230;</span>
            <span class="fhe-calculated-cutoff-timer">Order by Sunday Midnight for Friday Delivery</span>
          </div>
          <div class="fhe-cta-actions">
            <a href="#fhe-menu-section" class="fhe-btn fhe-btn--accent fhe-cta-btn">Browse This Week's Menu &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FRESH HEAT-N-EAT MEAL CUSTOMIZE & ADD DRAWER / MODAL -->
  <div id="fhe-meal-modal" class="fhe-modal-backdrop" aria-hidden="true">
    <div class="fhe-modal-card fhe-customizer-drawer">
      <button type="button" class="fhe-modal-close" aria-label="Close customization drawer">&times;</button>
      <div class="fhe-modal-grid">
        <div class="fhe-modal-media">
          <img id="fhe-modal-img" src="" alt="Meal Detail Image">
        </div>
        <div class="fhe-modal-info">
          <div id="fhe-modal-rating" class="fhe-meal-card__rating" style="margin-bottom: 8px;">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h2 id="fhe-modal-title" class="fhe-modal-title">Meal Title</h2>
          <p id="fhe-modal-desc" class="fhe-modal-desc">Meal Description</p>
          
          <div class="fhe-modal-section">
            <h4>Nutrition Macros</h4>
            <div id="fhe-modal-macros" class="fhe-meal-card__macros" style="margin-bottom: 0;"></div>
          </div>

          <div class="fhe-modal-section">
            <h4>Heating Instructions</h4>
            <p id="fhe-modal-heating" class="fhe-modal-text">1. Peel back lid corner. 2. Microwave on HIGH for 1:30-2:00 minutes. 3. Let stand 1 minute before serving.</p>
          </div>

          <div class="fhe-modal-section">
            <h4>Ingredients</h4>
            <p id="fhe-modal-ingredients" class="fhe-modal-text">Chef selected fresh ingredients.</p>
          </div>

          <div class="fhe-modal-customizer-wrap" style="margin-top: 16px;">
            <input type="hidden" id="fhe-modal-variant-id" value="">
            <input type="hidden" id="fhe-modal-product-id" value="">
            {% render 'fhe-meal-customizer', context: 'modal' %}
          </div>

          <div class="fhe-modal-footer-sticky">
            <div class="fhe-qty-picker">
              <button type="button" class="fhe-qty-btn fhe-qty-btn--minus" aria-label="Decrease meal quantity">-</button>
              <input type="number" name="quantity" value="1" min="1" class="fhe-qty-input" aria-label="Meal quantity">
              <button type="button" class="fhe-qty-btn fhe-qty-btn--plus" aria-label="Increase meal quantity">+</button>
            </div>
            <button type="button" class="fhe-btn fhe-btn--primary fhe-submit-customizer-btn">
              Add to Cart — <span class="fhe-customizer-btn-price">$0.00</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>


