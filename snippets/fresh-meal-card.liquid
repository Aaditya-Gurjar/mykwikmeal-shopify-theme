{% comment %}
  KwikMeal Fresh Heat-N-Eat Meal Card Component
  Accepts:
  - product: {Object} Product object (required)
{% endcomment %}

{% liquid
  assign calories = ''
  assign protein = ''
  assign dietary_tags = ''

  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'calories:' or tag_lower contains 'cal:'
      assign calories = tag | split: ':' | last
    elsif tag_lower contains 'protein:'
      assign protein = tag | split: ':' | last
    elsif tag_lower == 'vegetarian' or tag_lower == 'veg'
      assign dietary_tags = dietary_tags | append: ' Vegetarian'
    elsif tag_lower == 'vegan'
      assign dietary_tags = dietary_tags | append: ' Vegan'
    elsif tag_lower == 'high protein'
      assign dietary_tags = dietary_tags | append: ' High Protein'
    elsif tag_lower == 'gluten free' or tag_lower == 'gluten-free'
      assign dietary_tags = dietary_tags | append: ' Gluten Free'
    endif
  endfor

  if calories == blank and product.metafields.custom.calories != blank
    assign calories = product.metafields.custom.calories
  endif
  if protein == blank and product.metafields.custom.protein != blank
    assign protein = product.metafields.custom.protein
  endif
%}

<div
  class="fhe-meal-card"
  data-product-id="{{ product.id }}"
  data-product-url="{{ product.url }}"
  data-dietary="{{ dietary_tags }}"
  data-base-price="{{ product.price | divided_by: 100.0 }}"
  data-price="{{ product.price | divided_by: 100.0 }}"
>
  <div class="fhe-meal-card__media">
    <a href="{{ product.url }}" aria-label="{{ product.title }}">
      {% if product.featured_image != blank %}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" class="fhe-meal-card__img">
      {% else %}
        <img src="{{ 'fhe_banner_meal.png' | asset_url }}" alt="{{ product.title | escape }}" loading="lazy" class="fhe-meal-card__img">
      {% endif %}
    </a>

    <div class="fhe-meal-card__badges">
      {% for tag in product.tags %}
        {% assign tag_lower = tag | downcase %}
        {% if tag_lower == 'popular' or tag_lower == 'best seller' or tag_lower == 'new' %}
          <span class="fhe-meal-card__tag">{{ tag }}</span>
        {% elsif tag_lower == 'vegetarian' or tag_lower == 'veg' %}
          <span class="fhe-meal-card__tag fhe-meal-card__tag--veg">&#127793; Vegetarian</span>
        {% elsif tag_lower == 'high protein' %}
          <span class="fhe-meal-card__tag fhe-meal-card__tag--protein">&#128170; High Protein</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="fhe-meal-card__content">
    <div class="fhe-meal-card__header">
      <div class="fhe-meal-card__rating">
        {% render 'product-reviews-app__badge', product: product %}
      </div>

      <a href="{{ product.url }}" class="fhe-meal-card__title">
        {{ product.title }}
      </a>

      {% if product.description != blank %}
        <div class="fhe-meal-card__desc">
          {{ product.description | strip_html | truncate: 90 }}
        </div>
      {% endif %}
    </div>

    {% if calories != blank or protein != blank %}
      <div class="fhe-meal-card__macros">
        {% if calories != blank %}
          <div class="fhe-meal-card__macro-item">
            <span aria-hidden="true">&#128293;</span>
            <span>{{ calories }} Cal</span>
          </div>
        {% endif %}
        {% if protein != blank %}
          <div class="fhe-meal-card__macro-item">
            <span aria-hidden="true">&#129385;</span>
            <span>{{ protein }} Protein</span>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Add-ons Selection -->
    <div class="fhe-meal-card__addons-wrapper">
      <label class="fhe-addon-label">Optional Add-ons:</label>
      <div class="fhe-addon-checkboxes">
        <label class="fhe-addon-checkbox-item">
          <input type="checkbox" class="fhe-addon-checkbox" data-title="Raita" data-price="2.00" data-variant-id="8690526453933" value="Raita (+$2.00)">
          <span>Raita (+$2.00)</span>
        </label>
        <label class="fhe-addon-checkbox-item">
          <input type="checkbox" class="fhe-addon-checkbox" data-title="Salad" data-price="2.00" data-variant-id="8690526585005" value="Salad (+$2.00)">
          <span>Salad (+$2.00)</span>
        </label>
        <label class="fhe-addon-checkbox-item">
          <input type="checkbox" class="fhe-addon-checkbox" data-title="Roti" data-price="2.00" data-variant-id="8690527076525" value="Roti (+$2.00)">
          <span>Roti (+$2.00)</span>
        </label>
      </div>
    </div>

    <form method="post" action="/cart/add" class="fhe-meal-card__form" style="margin-top: auto;">
      <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
      <input type="hidden" name="properties[Add-ons]" class="fhe-addon-hidden-input" value="None">
      <input type="hidden" name="properties[Expected Delivery Date]" class="fhe-delivery-date-hidden-input" value="">
      <input type="hidden" name="properties[Delivery Week]" class="fhe-delivery-week-hidden-input" value="">

      <div class="fhe-meal-card__footer">
        <div class="fhe-meal-card__price">
          {{ product.price | money }}
        </div>

        <div class="fhe-meal-card__actions">
          <div class="fhe-qty-picker">
            <button type="button" class="fhe-qty-btn fhe-qty-btn--minus">-</button>
            <input type="number" name="quantity" value="1" min="1" class="fhe-qty-input">
            <button type="button" class="fhe-qty-btn fhe-qty-btn--plus">+</button>
          </div>

          <button type="submit" class="fhe-btn fhe-btn--primary fhe-add-to-cart-btn">
            + Add to Order
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

