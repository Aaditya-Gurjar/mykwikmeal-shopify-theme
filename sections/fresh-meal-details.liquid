{% comment %}
  KwikMeal Fresh Heat-N-Eat Product Details Section
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'container-fluid'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif

  assign calories = ''
  assign protein = ''

  for tag in product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'calories:' or tag_lower contains 'cal:'
      assign calories = tag | split: ':' | last
    elsif tag_lower contains 'protein:'
      assign protein = tag | split: ':' | last
    endif
  endfor

  if calories == blank and product.metafields.custom.calories != blank
    assign calories = product.metafields.custom.calories
  endif
  if protein == blank and product.metafields.custom.protein != blank
    assign protein = product.metafields.custom.protein
  endif
%}

<div class="fhe-product-details-section m-section-my">
  <div class="{{ container_class }}">
    <!-- Go Back to Menu — Top Navigation -->
    <div class="fhe-pdp-top-nav">
      <a href="/pages/fresh-heat-n-eat#fhe-menu-section" class="fhe-back-to-menu-link" id="fhe-back-to-menu-top">
        <span aria-hidden="true">&larr;</span>
        <span>Go Back to Menu</span>
      </a>
    </div>

    <div class="fhe-pdp-grid">
      <!-- Product Gallery -->
      <div class="fhe-product-media">
        <div class="fhe-pdp-main-image-wrap">
          {% if product.featured_image != blank %}
            <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" loading="eager" class="fhe-pdp-main-img">
          {% else %}
            <img src="{{ 'fhe_banner_meal.png' | asset_url }}" alt="{{ product.title | escape }}" loading="eager" class="fhe-pdp-main-img">
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="fhe-pdp-thumbnails">
            {% for image in product.images %}
              <div class="fhe-pdp-thumb-item {% if forloop.first %}is-active{% endif %}">
                <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" loading="lazy">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info & Add-to-Cart Form -->
      <div class="fhe-product-info" data-base-price="{{ product.price | money_without_currency | replace: ',', '' }}" data-price="{{ product.price | money_without_currency | replace: ',', '' }}">
        <div class="fhe-badge-pill">Chef Prepared Heat-N-Eat Meal</div>

        {% for tag in product.tags %}
          {% assign tag_lower = tag | downcase %}
          {% if tag_lower == 'high protein' or tag_lower == 'high-protein badge' %}
            <span class="fhe-badge-pill fhe-badge-pill--protein">🏋️ High Protein</span>
          {% endif %}
        {% endfor %}

        <h1 class="fhe-pdp-title">
          {{ product.title }}
        </h1>

        <div class="fhe-pdp-rating">
          {% render 'product-reviews-app__badge', product: product %}
        </div>

        <div class="fhe-pdp-price">
          {{ product.price | money }}
        </div>

        {% if product.description != blank %}
          <div class="fhe-pdp-description">
            {{ product.description }}
          </div>
        {% endif %}

        {% if calories != blank or protein != blank %}
          <div class="fhe-meal-card__macros fhe-pdp-macros">
            {% if calories != blank %}
              <div class="fhe-meal-card__macro-item fhe-meal-card__macro-item--calories">
                <span class="fhe-macro-icon" aria-hidden="true">&#128293;</span> <span class="fhe-macro-label"><strong>{{ calories }}</strong> Calories</span>
              </div>
            {% endif %}
            {% if protein != blank %}
              <div class="fhe-meal-card__macro-item fhe-meal-card__macro-item--protein">
                <span class="fhe-macro-icon" aria-hidden="true">&#129385;</span> <span class="fhe-macro-label"><strong>{{ protein }}</strong> Protein</span>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <!-- Expected Delivery Pill -->
        <div class="fhe-cutoff-timer fhe-pdp-delivery-pill">
          <span aria-hidden="true">&#128230;</span>
          <span>Delivered Fresh: <strong class="fhe-calculated-delivery-date">Friday Delivery</strong></span>
        </div>

        <!-- Add to Cart Form (Top) -->
        <form method="post" action="/cart/add" class="fhe-pdp-form">
          <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
          <input type="hidden" name="properties[Add-ons]" class="fhe-addon-hidden-input" value="None">
          <input type="hidden" name="properties[Expected Delivery Date]" class="fhe-delivery-date-hidden-input" value="">
          <input type="hidden" name="properties[Delivery Week]" class="fhe-delivery-week-hidden-input" value="">

          {% render 'fhe-meal-customizer', context: 'pdp', product: product %}

          <div class="fhe-pdp-form-row">
            <div class="fhe-qty-picker">
              <button type="button" class="fhe-qty-btn fhe-qty-btn--minus">-</button>
              <input type="number" name="quantity" value="1" min="1" class="fhe-qty-input">
              <button type="button" class="fhe-qty-btn fhe-qty-btn--plus">+</button>
            </div>

            <button type="button" class="fhe-btn fhe-btn--primary fhe-pdp-submit-btn">
              + Add to Weekly Order
            </button>
          </div>
        </form>

        <!-- Pair Your Meal with Standalone Sides Section -->
        <div class="fhe-pdp-standalone-sides-card">
          <div class="fhe-pdp-sides-header">
            <h4 class="fhe-pdp-sides-title">🍛 Want Only Sides?</h4>
            <p class="fhe-pdp-sides-subtitle">Add standalone sides directly to your cart without re-adding your main meal!</p>
          </div>
          <div class="fhe-pdp-sides-grid">
            <div class="fhe-pdp-side-item">
              <div class="fhe-pdp-side-details">
                <strong>Fresh Raita</strong>
                <span>Cool yogurt with cucumber &amp; roasted cumin ($2.00)</span>
              </div>
              <button type="button" class="fhe-btn fhe-btn--secondary fhe-add-standalone-side-btn" data-variant-id="8690526453933" data-title="Fresh Raita" data-price="2.00">
                + Add Raita ($2.00)
              </button>
            </div>

            <div class="fhe-pdp-side-item">
              <div class="fhe-pdp-side-details">
                <strong>Fresh Garden Salad</strong>
                <span>Sliced onions, cucumber, tomato &amp; lemon ($2.00)</span>
              </div>
              <button type="button" class="fhe-btn fhe-btn--secondary fhe-add-standalone-side-btn" data-variant-id="8690526585005" data-title="Fresh Salad" data-price="2.00">
                + Add Salad ($2.00)
              </button>
            </div>

            <div class="fhe-pdp-side-item">
              <div class="fhe-pdp-side-details">
                <strong>Tandoori Roti (2 Pcs)</strong>
                <span>Freshly baked whole wheat flatbread ($2.00)</span>
              </div>
              <button type="button" class="fhe-btn fhe-btn--secondary fhe-add-standalone-side-btn" data-variant-id="8690527076525" data-title="Roti (2 pcs)" data-price="2.00">
                + Add Roti ($2.00)
              </button>
            </div>
          </div>
        </div>

        <!-- Heating & Storage Accordions -->
        <div class="fhe-faq-list fhe-pdp-accordions">
          <div class="fhe-faq-item is-open">
            <button type="button" class="fhe-faq-question">
              <span>Reheating Instructions</span>
              <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
            </button>
            <div class="fhe-faq-answer">
              <p><strong>Microwave:</strong> Peel back film of both compartments or single compartment tray about an inch. Microwave on HIGH for 2&ndash;3 minutes. Tray and contents will be hot. Carefully remove tray. Let stand for 1 minute before serving.</p>
              <p style="margin-top: 8px;"><strong>Oven:</strong> You can also heat it in a preheated oven. Cover tray with aluminum foil. Internal food temperature must reach 165&deg;F (74&deg;C).</p>
            </div>
          </div>

          <div class="fhe-faq-item">
            <button type="button" class="fhe-faq-question">
              <span>Storage &amp; Shelf Life</span>
              <span class="fhe-faq-chevron" aria-hidden="true">&#9662;</span>
            </button>
            <div class="fhe-faq-answer">
              Keep refrigerated at or below 40&deg;F immediately upon arrival. Best enjoyed within 5 days of delivery date. Can be frozen for up to 30 days.
            </div>
          </div>
        </div>

        <!-- Bottom Add to Cart (Point 8B) -->
        <div class="fhe-pdp-bottom-actions">
          <form method="post" action="/cart/add" class="fhe-pdp-form fhe-pdp-bottom-form">
            <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
            <input type="hidden" name="properties[Add-ons]" class="fhe-addon-hidden-input" value="None">
            <input type="hidden" name="properties[Expected Delivery Date]" class="fhe-delivery-date-hidden-input" value="">
            <input type="hidden" name="properties[Delivery Week]" class="fhe-delivery-week-hidden-input" value="">

            <div class="fhe-pdp-form-row">
              <div class="fhe-qty-picker">
                <button type="button" class="fhe-qty-btn fhe-qty-btn--minus">-</button>
                <input type="number" name="quantity" value="1" min="1" class="fhe-qty-input">
                <button type="button" class="fhe-qty-btn fhe-qty-btn--plus">+</button>
              </div>

              <button type="button" class="fhe-btn fhe-btn--primary fhe-pdp-submit-btn">
                + Add to Weekly Order
              </button>
            </div>
          </form>

          <!-- Go Back to Menu Link (Point 8C) -->
          <a href="/pages/fresh-heat-n-eat#fhe-menu-section" class="fhe-btn fhe-btn--outline fhe-back-to-menu-btn">
            &larr; Go Back to Menu
          </a>
        </div>
      </div>
    </div>

    <div class="fhe-pdp-reviews-widget" style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--fhe-border);">
      {% render 'product-reviews-app__snippet', product: product %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Meal Details",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "w-full",
          "label": "Full Width"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    }
  ]
}
{% endschema %}

