{% comment %}
  KwikMeal Fresh Heat-N-Eat Meal Menu Section
  Renders 12 realistic chef-prepared dummy meals by default so general store products (marinades, snacks) are never shown.
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'container-fluid'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif

  assign use_live_products = false
  if section.settings.use_live_products == true and section.settings.collection != blank
    assign collection = collections[section.settings.collection]
    if collection != blank and collection.products.size > 0
      assign use_live_products = true
    endif
  endif

  assign limit = section.settings.products_to_show | default: 12
%}

<div id="fhe-menu-section" class="fhe-menu-section m-section-my">
  <div class="{{ container_class }}">
    <div class="fhe-section-header">
      {% if section.settings.badge != blank %}
        <div class="fhe-badge-pill">
          {{ section.settings.badge }}
        </div>
      {% endif %}
      <h2 class="fhe-title-section">
        {{ section.settings.heading | default: "Chef-Prepared Heat-N-Eat Meals" }}
      </h2>
      <p class="fhe-subtitle">
        {{ section.settings.subheading | default: "Delivered fresh, ready to heat and serve in 3 minutes." }}
      </p>
    </div>

    <!-- Filter, Search & Sort Toolbar -->
    <div class="fhe-filter-bar">
      <div class="fhe-filter-pills">
        <button type="button" class="fhe-filter-btn is-active" data-filter="all">All Meals</button>
        <button type="button" class="fhe-filter-btn" data-filter="high protein">💪 High Protein</button>
        <button type="button" class="fhe-filter-btn" data-filter="vegetarian">🌱 Vegetarian</button>
        <button type="button" class="fhe-filter-btn" data-filter="vegan">🌿 Vegan</button>
        <button type="button" class="fhe-filter-btn" data-filter="gluten free">🌾 Gluten Free</button>
      </div>

      <div class="fhe-menu-controls">
        <div class="fhe-menu-search-wrap">
          <input type="text" class="fhe-menu-search-input" placeholder="🔍 Search meals..." aria-label="Search meals">
        </div>

        <select class="fhe-menu-sort-select" aria-label="Sort meals">
          <option value="default">Sort: Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="calories">Calories: Low to High</option>
        </select>
      </div>
    </div>

    <!-- Meal Cards Grid -->
    <div class="fhe-menu-grid">
      {% if use_live_products %}
        {% for product in collection.products limit: limit %}
          {% render 'fresh-meal-card', product: product %}
        {% endfor %}
      {% else %}
        {% comment %} DEMO MEALS CATALOG (12 Realistic Chef Prepared Meals) {% endcomment %}
        
