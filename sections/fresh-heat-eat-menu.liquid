                <label class="fhe-addon-checkbox-item"><input type="checkbox" class="fhe-addon-checkbox" value="Mango Lassi (+$4.00)" data-title="Mango Lassi" data-price="4.00"><span>Mango Lassi (+$4.00)</span></label>
