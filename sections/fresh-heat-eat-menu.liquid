{% comment %}
  KwikMeal Fresh Heat-N-Eat Meal Menu Section
  Renders real products from the selected Fresh Heat-N-Eat collection.
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'container-fluid'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif

  assign use_live_products = false
  if section.settings.use_live_products == true and section.settings.collection != blank
    assign collection = collections[section.settings.collection]
    if collection != blank and collection.products.size > 0
      assign use_live_products = true
    endif
  endif

  assign limit = section.settings.products_to_show | default: 12
%}

<div id="fhe-menu-section" class="fhe-menu-section m-section-my">
  <div class="{{ container_class }}">
    <div class="fhe-section-header">
      {% if section.settings.badge != blank %}
        <div class="fhe-badge-pill">
          {{ section.settings.badge }}
        </div>
      {% endif %}
      <h2 class="fhe-title-section">
        {{ section.settings.heading | default: "Chef Prepared Heat-N-Eat Meals" }}
      </h2>
      <p class="fhe-subtitle">
        {{ section.settings.subheading | default: "Delivered fresh, ready to heat and serve in 3 minutes." }}
      </p>
    </div>

    <!-- Filter, Search & Sort Toolbar -->
    <div class="fhe-filter-bar">
      <div class="fhe-filter-pills">
        <button type="button" class="fhe-filter-btn is-active" data-filter="all">All Meals</button>
        <button type="button" class="fhe-filter-btn" data-filter="high protein">&#128170; High Protein</button>
        <button type="button" class="fhe-filter-btn" data-filter="vegetarian">&#127793; Vegetarian</button>
        <button type="button" class="fhe-filter-btn" data-filter="vegan">&#127807; Vegan</button>
        <button type="button" class="fhe-filter-btn" data-filter="gluten free">&#127806; Gluten Free</button>
      </div>

      <div class="fhe-menu-controls">
        <div class="fhe-menu-search-wrap">
          <input type="text" class="fhe-menu-search-input" placeholder="Search meals..." aria-label="Search meals">
        </div>

        <select class="fhe-menu-sort-select" aria-label="Sort meals">
          <option value="default">Sort: Featured</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="calories">Calories: Low to High</option>
        </select>
      </div>
    </div>

    <!-- Delivery Charge Banner -->
    {% if section.settings.delivery_charge != blank %}
      <div class="fhe-delivery-charge-card" style="margin-bottom: 28px;">
        <span aria-hidden="true">&#128230;</span>
        <span>Flat Handling &amp; Delivery Charges: <strong>{{ section.settings.delivery_charge }}</strong> per order</span>
      </div>
    {% endif %}

    <!-- Meal Cards Grid -->
    <div class="fhe-menu-grid">
      {% if use_live_products %}
        {% for product in collection.products limit: limit %}
          {% render 'fresh-meal-card', product: product %}
        {% endfor %}
      {% else %}
        <div class="fhe-menu-empty" role="status">
          <h3>This week's menu is coming soon.</h3>
          <p>Select the active <strong>fresh-heat-n-eat</strong> collection in this section's settings to display real meals.</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Heat Menu",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "w-full",
          "label": "Full Width"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_live_products",
      "label": "Use Live Shopify Collection Products",
      "default": false,
      "info": "Enable this and select the Fresh Heat-N-Eat collection to display real products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Meal Collection"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "This Week's Menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chef Prepared Heat-N-Eat Meals"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivered fresh, ready to heat and serve in 3 minutes."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "text",
      "id": "delivery_charge",
      "label": "Delivery Charge Display",
      "default": "$10.00",
      "info": "Flat handling and delivery charge shown above the menu. Leave blank to hide."
    }
  ],
  "presets": [
    {
      "name": "Fresh Heat Menu"
    }
  ]
}
{% endschema %}


