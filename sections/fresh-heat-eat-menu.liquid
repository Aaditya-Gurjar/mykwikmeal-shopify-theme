{% schema %}
{
  "name": "Fresh Heat Menu",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "w-full",
          "label": "Full Width"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "use_live_products",
      "label": "Use Live Shopify Collection Products",
      "default": false,
      "info": "Leave unchecked to display the 12 chef-prepared demo meals."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Meal Collection"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "This Week's Menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chef-Prepared Heat-N-Eat Meals"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Delivered fresh, ready to heat and serve in 3 minutes."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Fresh Heat Menu"
    }
  ]
}
{% endschema %}
