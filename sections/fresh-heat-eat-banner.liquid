{% comment %}
  KwikMeal Fresh Heat-N-Eat Homepage Banner Section
  Sleek compact height, full width edge-to-edge support, configurable margins.
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'w-full'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif

  assign bg_gradient = section.settings.bg_gradient
  assign bg_color = section.settings.bg_color | default: '#0d5c46'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign button_bg = section.settings.button_bg | default: '#ea9849'
  assign button_text_color = section.settings.button_text_color | default: '#ffffff'
%}

<style>
  #fhe-banner-{{ section.id }} {
    --fhe-banner-bg-color: {{ bg_color }};
    {% if bg_gradient != blank %}
      --fhe-banner-bg: {{ bg_gradient }};
    {% else %}
      --fhe-banner-bg: linear-gradient(135deg, {{ bg_color }} 0%, #063125 100%);
    {% endif %}
    --fhe-banner-text-color: {{ text_color }};
    --fhe-banner-btn-bg: {{ button_bg }};
    --fhe-banner-btn-text: {{ button_text_color }};
    margin-top: {{ section.settings.margin_top | default: 32 }}px;
    margin-bottom: {{ section.settings.margin_bottom | default: 32 }}px;
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }
</style>

<div id="fhe-banner-{{ section.id }}" class="fhe-banner-section {{ section.settings.custom_class }}">
  <div class="{{ container_class }}">
    <div class="fhe-banner-card {% if container == 'w-full' or container == 'container-full' %}fhe-banner-card--full-width{% endif %}">
      <!-- Decorative background elements -->
      <div class="fhe-banner-card__glow fhe-banner-card__glow--1"></div>
      <div class="fhe-banner-card__glow fhe-banner-card__glow--2"></div>

      <div class="fhe-banner-grid">
        <div class="fhe-banner-content">
          {% if section.settings.subbrand_label != blank %}
            <div class="fhe-badge-pill fhe-badge-pill--accent">
              <span></span> {{ section.settings.subbrand_label }}
            </div>
          {% endif %}

          <h2 class="fhe-banner-card__title">
            {{ section.settings.title | default: "Chef Prepared Meals Delivered Fresh Every Week" }}
          </h2>

          {% if section.settings.subtitle != blank %}
            <p class="fhe-banner-card__subtitle">
              {{ section.settings.subtitle }}
            </p>
          {% endif %}

          <!-- Calculated Delivery Cutoff Pill -->
          <div class="fhe-banner-card__cutoff-pill">
            <span></span>
            <span class="fhe-calculated-cutoff-timer">Order by Sunday Midnight for Friday Delivery</span>
          </div>

          <div class="fhe-banner-card__cta-wrap">
            <a href="{{ section.settings.button_link | default: '/pages/fresh-heat-n-eat' }}" class="fhe-btn fhe-banner-card__cta">
              {{ section.settings.button_text | default: "Order Now" }} 
            </a>
          </div>
        </div>

        <div class="fhe-banner-image-wrap">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                      {{ section.settings.image | image_url: width: 600 }} 600w,
                      {{ section.settings.image | image_url: width: 800 }} 800w"
              sizes="(max-width: 767px) 92vw, 40vw"
              alt="{{ section.settings.title | escape }}"
              loading="lazy"
              width="800"
              height="450"
              class="fhe-banner-image-wrap__img"
            >
          {% else %}
            <div class="fhe-banner-hero-media">
              <img
                src="{{ 'fhe_banner_meal.png' | asset_url }}"
                alt="Fresh Chef Prepared Heat-N-Eat Meals"
                loading="eager"
                width="800"
                height="480"
                class="fhe-banner-hero-media__img"
              >
              <!-- Interactive Floating Emoji Badges -->
              <div class="fhe-banner-float-badge fhe-banner-float-badge--top-left fhe-emoji-float">
                <span class="fhe-emoji-bounce"></span>
                <span>Chef Prepared</span>
              </div>
              <div class="fhe-banner-float-badge fhe-banner-float-badge--top-right fhe-emoji-wiggle">
                <span></span>
                <span>Delivered Fresh</span>
              </div>
              <div class="fhe-banner-float-badge fhe-banner-float-badge--bottom-right fhe-emoji-bounce">
                <span></span>
                <span>Ready in 3 Mins</span>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Heat Banner",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Width"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "w-full",
      "options": [
        {
          "value": "w-full",
          "label": "Full Width (100% Screen Edge-to-Edge)"
        },
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subbrand_label",
      "label": "Sub-brand Label",
      "default": "KwikMeal Fresh Heat-N-Eat"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Chef Prepared Meals Delivered Fresh Every Week"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Healthy  Fresh  Ready in Minutes"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "Order Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "header",
      "content": "Live Shopify Products (Optional)"
    },
    {
      "type": "checkbox",
      "id": "use_live_products",
      "label": "Use Live Shopify Collection Products",
      "default": false,
      "info": "Enable to pull real dynamic product titles, images, and prices uploaded in Shopify Admin."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Meal Collection"
    },
    {
      "type": "header",
      "content": "Colors & Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0d5c46"
    },
    {
      "type": "color_background",
      "id": "bg_gradient",
      "label": "Background Gradient",
      "default": "linear-gradient(135deg, #0d5c46 0%, #063125 100%)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#ea9849"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section Margins & Padding"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "default": 32,
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "default": 32,
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Fresh Heat Banner"
    }
  ]
}
{% endschema %}

