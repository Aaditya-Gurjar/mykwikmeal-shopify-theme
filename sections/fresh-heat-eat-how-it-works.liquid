{% comment %}
  KwikMeal Fresh Heat-N-Eat How It Works Section
{% endcomment %}

<div class="fhe-section" style="padding: 70px 0; background: #ffffff;">
  <div class="fhe-container">
    <div style="text-align: center; margin-bottom: 48px;">
      <div class="fhe-badge-pill" style="margin-bottom: 12px;">Simple & Convenient</div>
      <h2 class="fhe-title-section" style="margin: 0 auto 12px;">How Weekly Pre-Ordering Works</h2>
      <p class="fhe-subtitle" style="margin: 0 auto;">Fresh meals crafted by chefs, delivered straight to your door every week.</p>
    </div>

    <div class="fhe-steps-grid">
      <div class="fhe-step-card">
        <div class="fhe-step-num">1</div>
        <h3 class="fhe-step-title">Browse Meals</h3>
        <p class="fhe-step-desc">Explore our chef-curated weekly menu of authentic, delicious Heat-N-Eat meals.</p>
      </div>

      <div class="fhe-step-card">
        <div class="fhe-step-num">2</div>
        <h3 class="fhe-step-title">Choose Meals</h3>
        <p class="fhe-step-desc">Select single meals, weekly combos, and add-ons like rice, naan, and drinks.</p>
      </div>

      <div class="fhe-step-card">
        <div class="fhe-step-num">3</div>
        <h3 class="fhe-step-title">Order Before Cutoff</h3>
        <p class="fhe-step-desc">Place your order before Sunday 11:00 AM for current week delivery.</p>
      </div>

      <div class="fhe-step-card">
        <div class="fhe-step-num">4</div>
        <h3 class="fhe-step-title">Receive Fresh Meals</h3>
        <p class="fhe-step-desc">Enjoy chilled, chef-prepared meals delivered every Friday ready in minutes!</p>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "settings": []
}
{% endschema %}
