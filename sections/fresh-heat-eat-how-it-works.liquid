{% comment %}
  KwikMeal Fresh Heat-N-Eat How It Works Section
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'container-fluid'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif
%}

<div class="fhe-how-it-works-section m-section-my">
  <div class="{{ container_class }}">
    <div class="fhe-section-header">
      {% if section.settings.badge != blank %}
        <div class="fhe-badge-pill">
          {{ section.settings.badge }}
        </div>
      {% endif %}
      <h2 class="fhe-title-section">
        {{ section.settings.heading | default: "How Weekly Pre-Ordering Works" }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="fhe-subtitle">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <div class="fhe-steps-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="fhe-step-card" {{ block.shopify_attributes }}>
            <div class="fhe-step-num">
              {% if block.settings.icon != blank %}
                <span>{{ block.settings.icon }}</span>
              {% else %}
                <span>{{ forloop.index }}</span>
              {% endif %}
            </div>
            <h3 class="fhe-step-title">{{ block.settings.title }}</h3>
            <p class="fhe-step-desc">{{ block.settings.description }}</p>
          </div>
        {% endfor %}
      {% else %}
        <div class="fhe-step-card">
          <div class="fhe-step-num">🔍</div>
          <h3 class="fhe-step-title">Browse Meals</h3>
          <p class="fhe-step-desc">Explore our chef-curated weekly menu of authentic, delicious Heat-N-Eat meals.</p>
        </div>

        <div class="fhe-step-card">
          <div class="fhe-step-num">🍱</div>
          <h3 class="fhe-step-title">Choose Meals</h3>
          <p class="fhe-step-desc">Select single meals, weekly combos, and add-ons like extra rice, naan, and desserts.</p>
        </div>

        <div class="fhe-step-card">
          <div class="fhe-step-num">⏰</div>
          <h3 class="fhe-step-title">Order Before Cutoff</h3>
          <p class="fhe-step-desc">Place your order before Sunday 11:00 AM for current week delivery batch.</p>
        </div>

        <div class="fhe-step-card">
          <div class="fhe-step-num">🚚</div>
          <h3 class="fhe-step-title">Receive Fresh Meals</h3>
          <p class="fhe-step-desc">Enjoy chilled, chef-prepared meals delivered every Friday ready in 3 minutes!</p>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "w-full",
          "label": "Full Width"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Simple & Convenient"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Weekly Pre-Ordering Works"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fresh meals crafted by chefs, delivered straight to your door every week."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step Item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji or Icon Code",
          "default": "🍱"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Description of this step in the process."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "🔍",
            "title": "Browse Meals",
            "description": "Explore our chef-curated weekly menu of authentic, delicious Heat-N-Eat meals."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "🍱",
            "title": "Choose Meals",
            "description": "Select single meals, weekly combos, and add-ons like extra rice, naan, and desserts."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "⏰",
            "title": "Order Before Cutoff",
            "description": "Place your order before Sunday 11:00 AM for current week delivery batch."
          }
        },
        {
          "type": "step",
          "settings": {
            "icon": "🚚",
            "title": "Receive Fresh Meals",
            "description": "Enjoy chilled, chef-prepared meals delivered every Friday ready in 3 minutes!"
          }
        }
      ]
    }
  ]
}
{% endschema %}
