{% comment %}
  KwikMeal Fresh Heat-N-Eat Hero Section
{% endcomment %}

{% liquid
  assign container = section.settings.container | default: 'container-fluid'
  if container == 'w-full' or container == 'container-full'
    assign container_class = 'w-full p-0'
  else
    assign container_class = container
  endif
%}

<div class="fhe-hero-section m-section-my">
  <div class="{{ container_class }}">
    <div class="fhe-hero-card">
      <div class="fhe-hero-grid">
        <div class="fhe-hero-content">
          <div class="fhe-badge-pill fhe-badge-pill--accent">
            <span>🌱</span> {{ section.settings.badge | default: "Fresh Chef-Prepared Meals" }}
          </div>

          <h1 class="fhe-hero-title">
            {{ section.settings.headline | default: "Fresh Chef Prepared Meals Delivered Weekly" }}
          </h1>

          <p class="fhe-hero-subtitle">
            {{ section.settings.subheadline | default: "Freshly cooked. Delivered cold. Ready in minutes. Order before Sunday's cutoff." }}
          </p>

          <!-- Delivery Date Badge -->
          <div class="fhe-hero-delivery-badge">
            <span>📦</span>
            <span>Next Delivery: <strong class="fhe-calculated-delivery-date">Friday Delivery</strong></span>
          </div>

          <!-- Inline ZIP Code Validation Form -->
          <div class="fhe-zip-box fhe-hero-zip-box">
            <label class="fhe-hero-zip-label">
              Check Delivery Availability in Your Area:
            </label>
            <form class="fhe-zip-form">
              <input type="text" class="fhe-zip-input" placeholder="Enter ZIP Code (e.g. 48187)" required>
              <button type="submit" class="fhe-btn fhe-btn--primary">
                Check ZIP
              </button>
            </form>
            <div class="fhe-zip-status"></div>
          </div>

          <div class="fhe-hero-actions">
            <a href="#fhe-menu-section" class="fhe-btn fhe-btn--accent">
              Browse Available Meals ↓
            </a>
          </div>

          <!-- Trust Badges Strip -->
          <div class="fhe-hero-trust-strip">
            <div class="fhe-hero-trust-item">
              <span>👨‍🍳</span> Chef Prepared
            </div>
            <div class="fhe-hero-trust-item">
              <span>❄️</span> Chilled Fresh (Never Frozen)
            </div>
            <div class="fhe-hero-trust-item">
              <span>⏱️</span> Ready in 3 Minutes
            </div>
          </div>
        </div>

        <div class="fhe-hero-media">
          {% if section.settings.hero_image != blank %}
            <img
              src="{{ section.settings.hero_image | image_url: width: 900 }}"
              srcset="{{ section.settings.hero_image | image_url: width: 400 }} 400w,
                      {{ section.settings.hero_image | image_url: width: 600 }} 600w,
                      {{ section.settings.hero_image | image_url: width: 900 }} 900w"
              sizes="(max-width: 767px) 92vw, 45vw"
              alt="Fresh Chef Prepared Meals"
              loading="eager"
              width="900"
              height="600"
              class="fhe-hero-img"
            >
          {% else %}
            <img
              src="{{ 'fhe_banner_meal.png' | asset_url }}"
              alt="Fresh Chef Prepared Heat-N-Eat Meals"
              loading="eager"
              width="900"
              height="600"
              class="fhe-hero-img"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fresh Heat Hero",
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container Width",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Fluid Container"
        },
        {
          "value": "w-full",
          "label": "Full Width"
        },
        {
          "value": "container",
          "label": "Boxed Container"
        }
      ]
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Fresh Chef-Prepared Meals"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Fresh Chef Prepared Meals Delivered Weekly"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Freshly cooked. Delivered cold. Ready in minutes. Order before Sunday's cutoff."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Fresh Heat Hero"
    }
  ]
}
{% endschema %}
